# Copie este arquivo para `.env` e preencha com os valores do seu projeto.
# O `.env` esta no .gitignore e NUNCA deve ser versionado.

# ---------------------------------------------------------------------------
# Cliente (expostas no bundle do navegador - use apenas valores publicos)
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL="https://SEU_PROJECT_ID.supabase.co"
VITE_SUPABASE_PROJECT_ID="SEU_PROJECT_ID"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# ---------------------------------------------------------------------------
# Servidor (NUNCA expor no cliente / nao prefixar com VITE_)
# ---------------------------------------------------------------------------
SUPABASE_PROJECT_ID="SEU_PROJECT_ID"
SUPABASE_URL="https://SEU_PROJECT_ID.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Opcional: usada apenas na exclusao definitiva de conta (LGPD).
# Ignora RLS por completo. Trate como senha de administrador do banco:
# use somente no servidor, rotacione se houver qualquer suspeita de vazamento.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# ---------------------------------------------------------------------------
# IA (servidor apenas - a chave NUNCA pode chegar ao bundle do navegador)
# ---------------------------------------------------------------------------
# Sem chave nenhuma, o sistema continua funcionando por inteiro: o motor
# deterministico de regras nao depende de IA, e os recursos de IA degradam
# sozinhos (ver `iaConfigurada()` em src/lib/ai/modelo.server.ts).

# Provedor: "gemini" (padrao) ou "anthropic". Se ficar vazio, usa o primeiro
# que tiver chave configurada.
IA_PROVEDOR="gemini"

# --- Gemini (Google AI Studio) - tier gratuito, sem cartao ---------------
# ATENCAO: no tier GRATUITO o Google pode usar os prompts para treinar
# modelo. Por isso a minimizacao de dado nao e opcional aqui: so a descricao
# do lancamento e os agregados mensais saem do sistema - nunca valor, saldo,
# numero de conta ou titular. Decisao documentada no README.
# Limites free (ago/2026): ~1.500 requisicoes/dia, 15/min.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.1-flash-lite"

# --- Anthropic (Claude) - alternativa paga -------------------------------
# Sem tier gratuito, mas nao treina em input de API. Custo estimado deste
# projeto: ~R$ 0,02 por importacao com haiku-4-5.
# Precos por milhao de tokens (entrada/saida):
#   claude-opus-5     $5 / $25
#   claude-sonnet-5   $3 / $15
#   claude-haiku-4-5  $1 / $5
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"
