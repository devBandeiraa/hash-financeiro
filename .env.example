# Copie este arquivo para `.env` e preencha com os valores do seu projeto.
# O `.env` esta no .gitignore e NUNCA deve ser versionado.

# ---------------------------------------------------------------------------
# Cliente (expostas no bundle do navegador - use apenas valores publicos)
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL="https://SEU_PROJECT_ID.supabase.co"
VITE_SUPABASE_PROJECT_ID="SEU_PROJECT_ID"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# ---------------------------------------------------------------------------
# Servidor (NUNCA expor no cliente / nao prefixar com VITE_)
# ---------------------------------------------------------------------------
SUPABASE_PROJECT_ID="SEU_PROJECT_ID"
SUPABASE_URL="https://SEU_PROJECT_ID.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Opcional: usada apenas na exclusao definitiva de conta (LGPD).
# Ignora RLS por completo. Trate como senha de administrador do banco:
# use somente no servidor, rotacione se houver qualquer suspeita de vazamento.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."
